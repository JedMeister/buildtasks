#!/usr/bin/python3

"""
Initialise appliance & selenium containers ready for clicksnap
"""

import argparse
import socket
import subprocess
import sys
import os
from os.path import dirname, join, exists
from time import sleep

APP_NAME = "podsnap-init"

BT_PRODUCTS = os.getenv("BT_PRODUCTS", "/turnkey/fab/products")
BT_ISOS = os.getenv("BT_ISOS", "/mnt/isos")
BT_SCREENS = os.getenv("BT_SCREENS", join(dirname(BT_ISOS), "screens"))

SELENIUM_CONT = os.getenv("SELENIUM_CONT",
                          "docker.io/selenium/standalone-chrome")
SELENIUM_TAG = os.getenv("SELENIUM_TAG", "4.18.1-20240224")

APP_PORTS = [80, 443, 12321, 12322]
SEL_PORTS = [4444, 7900]
ADD_HOSTS = ['www.example.net']
TMP_FS = ['/run', '/run/lock']


def info(msg: str) -> None:
    print(f"INFO [{APP_NAME}] {msg}")


def warning(msg: str) -> None:
    print(f"WARN [{APP_NAME}] {msg}", file=sys.stderr)


def fatal(msg: str) -> None:
    print(f"FATAL [{APP_NAME}] {msg}", file=sys.stderr)
    sys.exit(1)


def get_host_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    s.connect(('<broadcast>', 12345))  # 12345 is random port
    return s.getsockname()[0]


def gen_args(switch: str, values: list[str | int | None]) -> list[str]:
    args = []
    for value in values:
        if value is not None:
            args.extend([switch, str(value)])
    return args


class Container:
    def __init__(self, cont_info: str):
        try:
            id, fullname, tag, status = cont_info.split(':')
            self.id = id
            self.fullname = fullname
            self.name = self._get_shortname(fullname)
            self.tag = tag
            self.status = self._trim_status(status)

        except ValueError:
            self.id = ""
            self.fullname = ""
            self.name = ""
            self.tag = ""
            self.status = ""

    @staticmethod
    def _get_shortname(fullname: str) -> str:
        split = fullname.split("/")
        if "selenium" in split:
            return "selenium"
        elif "tkl" in split:
            return split[-1]
        warning(f"unexpected container name: {fullname}")
        return ""

    @staticmethod
    def _trim_status(status: str) -> str:
        # short status should be one of: up|stopping|exited
        short_status = status.lower().split()[0]
        return short_status

    def check(self, value) -> bool:
        if (self.id.startswith(value)
                or self.fullname == value
                or self.name == value):
            return True
        return False

    @property
    def info(self) -> tuple[str, str, str, str, str]:
        return self.id, self.fullname, self.name, self.tag, self.status

    def __str__(self) -> str:
        if self.name:
            return self.name
        else:
            return "None"

    def __repr__(self) -> str:
        return f"Container{self.info}"


def find_container(container_id_name: str) -> Container:
    """Search for container id/name. Return first running container that
    matches, fallback to stopped matching container"""
    container = Container("")
    if container_id_name == "selenium":
        container_id_name = SELENIUM_CONT
    all_containers = subprocess.run(
                        ["podman", "ps", "--all",
                         "--format", "{{.ID}}:{{.Image}}:{{.Status}}"],
                        capture_output=True,
                        text=True,
                        check=True,
                        ).stdout
    for cont_info in all_containers.split('\n'):
        if cont_info:
            this_container = Container(cont_info)
            if this_container.check(container_id_name):
                if this_container.status == "up":
                    return this_container
                else:
                    container = this_container
    return container


def app_image_check(appliance: str,
                    existing_action: str = "die",
                    ) -> bool:
    """If app container exists; behaviour depends on 'existing_action':
        == 'die' - will fail (default)
                NoReturn
        == 'delete' - delete existing image and continue
                return True
        == 'allow' - skip dockerization and continue
                returns False
    """
    image_id = get_image_id(appliance)
    if image_id:
        msg = f"action = '{existing_action}'"
        if existing_action == "allow":
            info(f"{msg}, so continuing")
            return False
        elif existing_action == "delete":
            delete_image(appliance)
        else:
            fatal(f"{msg}; rerun with '--existing-action [delete|allow]'")
    else:
        warning(f"{appliance} image not found")
    return True  # just to make pyright happy...


def get_image_id(appliance: str) -> str:
    for image in subprocess.run(
                    ["podman",
                     "images",
                     "--format",
                     "{{.ID}}:{{.Repository}}"
                     ],
                    capture_output=True,
                    text=True,
                    check=True).stdout.split('\n'):
        if image:
            id, name = image.split(":")
            if name.endswith(f"/{appliance}"):
                info(f"{appliance} image found: {id}")
                return id
    warning(f"{appliance} image not found")
    return ""  # just to make pyright happy...


def delete_image(appliance: str) -> None:
    image_id = get_image_id(appliance)
    if image_id:
        warning(f"deleting {appliance} image (id: {image_id})")
        subprocess.run(
                ["podman", "rmi", "-f", image_id],
                capture_output=True,
                check=True
                )
        info(f"done")


def run_container(container: Container,
                  ports: list[int],
                  tmp_fs: list[str] = TMP_FS,
                  add_hosts: list[str] | None = None,
                  bind_ip: str = get_host_ip(),
                  ) -> str:
    """Start podman container and return container ID."""
    podman_com = ["podman"]
    if container.status:
        assume = "assuming has required ports & hosts entries"
        if container.status == "up":
            warning(f"{container} already running - {assume}")
            return container.id
        else:
            warning(f"{container} already exists, starting - {assume}")
            podman_args = ["start", container.id]
    else:
        hosts = add_hosts if add_hosts else []
        podman_args = ["run", "-dt", container.id]
        podman_args.extend(gen_args("-p", [f"{p}:{p}" for p in ports]))
        podman_args.extend(gen_args("--add-host",
                                    [f"{h}:{bind_ip}" for h in hosts]))
        podman_args.extend(gen_args("--tmpfs", list(tmp_fs)))
    podman_com.extend(podman_args)
    return subprocess.run(
                podman_com,
                capture_output=True,
                text=True,
                check=True,
                ).stdout


def wait_until_started(container: Container,
                       host: str = "127.0.0.1",
                       test_times: int = 25,
                       sleep_time: int = 2,
                       ) -> bool:

    def curl(schema: str, host: str, port: int) -> int:
        ping = subprocess.run(["curl",
                               "--location",  # follow redirects
                               "--insecure",  # ignore self signed cert
                               f"{schema}://{host}:{port}"
                               ],
                              capture_output=True,
                              ).returncode
        # returncode 0 == success == False, so return 'not returncode'
        return not bool(ping)

    schema = "https"
    if container.fullname == SELENIUM_CONT:
        schema = "http"
        port = 7900
    elif container.name == "tkldev":
        return True
    elif container.name == "core":
        port = 12321
    else:
        port = 443
    info(f"{container} - waiting for response on {schema}://{host}:{port}")
    for times_tried in range(test_times):
        times_remaining = test_times - times_tried
        if times_tried/5 == int(times_tried/5) and times_tried > 0:
            info(f"sleeping, will try up to {times_remaining} more times")
        if curl(schema, host, port):
            info(f"{container} running")
            return True
        else:
            sleep(sleep_time)
    return False


def dockerize_app(app_name: str,
                  src_path: str,
                  ) -> str:
    """Dockerize 'app_name' (from app rootfs or iso), start and return
    container name.
    """
    dockerize = ["dockerize", "--quiet"]
    product_rootfs = join(BT_PRODUCTS, app_name, "build", src_path)
    docker_src = ""
    if not src_path.endswith('iso'):
        if src_path == "root.sandbox":
            src_path = join(BT_PRODUCTS, app_name, "build", src_path)
        dockerize.extend(["--rootfs", join(product, src_path, "--deckroot"])
    else:
        dockerize.extend(["--iso", src_path])
    if not exists(src_path):
        fatal(f"source {src_path} not found")
    dockerize.extend(["--name", app_name])
    output = subprocess.run(dockerize,
                            capture_output=True,
                            text=True,
                            check=True,
                            ).stdout
    # workaround dockerize --quiet not really quiet enough...
    for line in (line for line in output if line.rstrip('\n')):
        return line
    fatal(f"no output from {' '.join(dockerize)}")
    return ""  # just to make pyright happy...


def stop_container(container: Container) -> None:
    if container.status == "up":
        info(f"stopping {container.name}")
        subprocess.run(["podman", "stop", container.id],
                       capture_output=True,
                       check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     )

    parser.add_argument("appliance",
                        help="Appliance name")
    parser.add_argument("-t", "--selenium-tag",
                        default=SELENIUM_TAG,
                        help=f"Selenium tag (default: {SELENIUM_TAG})")
    parser.add_argument("-p", "--app-port",
                        nargs="*", default=APP_PORTS,
                        action="extend", type=int,
                        help=("Additional port(s) to bind to appliance"
                              " container (defaults:"
                              f" {str(APP_PORTS).strip('[]')})"))
    parser.add_argument("-b", "--bind-container",
                        action="store_false",
                        help=("bind appliance container ports to the container"
                              " IP; otherwise bind to host"))
    parser.add_argument("-s", "--source-path",
                        default="root.sandbox",
                        help=("path to source rootfs/iso - iso must end in"
                              f" '.iso' (default {BT_PRODUCTS}/APP_NAME/build/root.sandbox)"))
    parser.add_argument("-e", "--existing-action",
                        default="die",
                        const="die",
                        nargs="?",
                        choices=["die", "delete", "allow"],
                        help=("Action to perform if appliance container"
                              " already exists (default: die)"))
    parser.add_argument("-S", "--stop",
                        action="store_true",
                        help=("Stop selenium and appliance containers - all"
                              " args above, other than 'appliance' are"
                              " ignored"))
    parser.add_argument("-C", "--clean",
                        action="store_true",
                        help=("Stop selenium container and delete appliance"
                              " image - all args above, other than 'appliance'"
                              " are ignored"))
    parser.add_argument("-F", "--full-clean",
                        action="store_true",
                        help=("Delete all containers and delete appliance"
                              " image - all above args, other than 'appliance'"
                              " are ignored"))
    args = parser.parse_args()

    if args.full_clean:
        subprocess.run(["podman", "rm", "-f", "-a"],
                       capture_output=True,
                       check=True)
        delete_image(args.appliance)
        info(f"all container(s) deleted and {args.appliance} image deleted")
        sys.exit(0)
    elif args.clean:
        stop_container(find_container("selenium"))
        delete_image(args.appliance)
        info(f"selenium container stopped and {args.appliance} image deleted")
        sys.exit(0)
    elif args.stop:
        stop_container(find_container(args.appliance))
        stop_container(find_container("selenium"))
        info(f"selenium and {args.appliance} containers stopped")
        sys.exit(0)

    if not args.bind_container:
        raise NotImplementedError("TODO --bind-container")
    if app_image_check(args.appliance, args.existing_action):
        info(f"dockerizing and starting {args.appliance} container -"
             " please wait")
        app_container = dockerize_app(args.appliance, args.source_path)
    else:
        app_container = find_container(args.appliance)
    sel_container = find_container("selenium")
    run_container(app_container, args.app_port)
    run_container(sel_container, ports=SEL_PORTS, add_hosts=ADD_HOSTS)

    info("checking containers are ready")
    if wait_until_started(sel_container):
        info("selenium container started")
    else:
        fatal("Given up waiting for selenium container")
    if wait_until_started(app_container):
        info(f"{args.appliance} container started")
    else:
        fatal(f"Given up waiting for {args.appliance} container")


if __name__ == "__main__":
    main()
